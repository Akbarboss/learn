<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight so the WebView reports the phone's light/dark setting to the
         page, and the page's own CSS picks the right palette. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
